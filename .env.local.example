# Kopieren nach .env.local und ausfüllen.
# Werte: Supabase Dashboard -> Project Settings -> API

# Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Öffentlicher Key (anon / publishable). Landet im Browser – das ist so gewollt,
# der Zugriff wird über die RLS-Policies begrenzt.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-Key (service_role / secret). UMGEHT RLS KOMPLETT.
# Nur serverseitig verwenden, niemals mit NEXT_PUBLIC_ prefixen,
# niemals committen.
SUPABASE_SERVICE_KEY=

# Vercel AI Gateway – für die KI-Fotoanalyse beim Artikel-Anlegen (Claude
# Haiku). Key holen: vercel.com/dashboard -> Team wählen -> "AI" (oberes
# Menü) -> "API Keys" -> "Create Key". Ohne diesen Key funktioniert der Rest
# der App normal weiter, nur der KI-Vorschlag beim Foto-Upload bleibt aus.
AI_GATEWAY_API_KEY=

# Resend – Transaktionsmails (Bestellbestätigung, Statusänderung, Rechnung).
# Einrichtung: vercel integration add resend -m domain=<eigene-domain> -m region=eu-west-1
# Braucht eine eigene, per DNS verifizierbare Domain. Ohne Key wird Mailversand
# übersprungen und nur geloggt (siehe lib/email.ts) – Rest der App läuft normal weiter.
RESEND_API_KEY=

# Absenderadresse für Transaktionsmails, z. B. "Lider Großhandel <bestellungen@domain.tld>".
# Muss zur bei Resend verifizierten Domain passen. Ohne Wert: Fallback auf
# Resend-Testadresse onboarding@resend.dev (nur Testmodus, kein Produktivversand).
EMAIL_FROM=

# Öffentliche Basis-URL des Shops, für Links in E-Mails und den
# Passwort-Reset-Redirect. Lokal: http://localhost:3000
NEXT_PUBLIC_SITE_URL=
